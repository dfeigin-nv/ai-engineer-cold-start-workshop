# Portable defaults. Copy this file to config.local.env and configure the
# target cluster before running setup.
HOST_CONTEXT=my-gpu-cluster
HOST_NAMESPACE=workshop-vcluster
VCLUSTER_NAME=workshop
VCLUSTER_LOCAL_PORT=8443
VCLUSTER_VERSION=0.36.1
HPM_VERSION=0.2.7

DYNAMO_VERSION=1.3.0
DYNAMO_REPO_URL=https://github.com/ai-dynamo/dynamo.git
DYNAMO_SOURCE_DIR=
MODEL_PRESET=120b
WORKER_CPU_REQUEST=32
WORKER_CPU_LIMIT=127
WORKER_MEMORY_REQUEST=192Gi
WORKER_MEMORY_LIMIT=256Gi
# Verified on B200. Lower this for GPUs with less HBM.
KV_CACHE_MEMORY_BYTES=68719476736

# Use dynamic for a portable empty model cache. Use static-nfs only when the
# NFS export is an intentional existing shared model cache.
STORAGE_CLASS=my-rwx-storage-class
MODEL_CACHE_MODE=dynamic
MODEL_CACHE_SIZE=100Gi
MODEL_CACHE_NFS_SERVER=
MODEL_CACHE_NFS_PATH=
SNAPSHOT_SIZE=500Gi

# Copy this pull secret from a host namespace into the vcluster.
NGC_SECRET_NAME=ngc-secret
NGC_SECRET_SOURCE_NAMESPACE=my-secrets-namespace

# Snapshot inside a vcluster requires the privileged host-path mapper.
INSTALL_HPM=yes
ALLOW_PRIVILEGED_HPM=no

# Existing kube-prometheus-stack-compatible monitoring installation.
MONITORING_NAMESPACE=monitoring
PROMETHEUS_RELEASE=kube-prometheus-stack
INSTALL_PODMONITORS=yes
GRAFANA_SERVICE=kube-prometheus-stack-grafana
GRAFANA_SECRET=kube-prometheus-stack-grafana
GRAFANA_DATASOURCE_UID=prometheus
GRAFANA_LOKI_DATASOURCE_UID=P8E80F9AEF21F6940
GRAFANA_LOCAL_PORT=3030

# Optional and host-wide. Set an exact comma-separated node list and change
# ALLOW_HOST_CACHE_DROP only after checking that no other tenant will be hurt.
DROP_CACHES_BEFORE_DEMO=no
CACHE_DROP_NODES=
ALLOW_HOST_CACHE_DROP=no

DEMO_TIMEOUT_SECONDS=600
AIPERF_CONCURRENCY=4
AIPERF_DURATION_SECONDS=180
AIPERF_MAX_COMPLETION_TOKENS=128
AIPERF_RECOVERY_SECONDS=20
BASE_FRONTEND_LOCAL_PORT=18000
FAST_FRONTEND_LOCAL_PORT=18001
